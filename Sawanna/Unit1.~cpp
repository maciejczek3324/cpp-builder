// ==================================================
// 1. KLASA BAZOWA
// ==================================================

class Organizm {
protected:
    int x, y;
    char znak;
    int wiek;
    int maxWiek;
    char plec; 
    int czasDoRozmnozenia; 
public:
    Organizm(int x, int y, char z, char p, int mw) 
        : x(x), y(y), znak(z), plec(p), wiek(0), maxWiek(mw), czasDoRozmnozenia(0) {}
    virtual ~Organizm() {}
    
    virtual void akcja(Organizm* plansza[ROZMIAR][ROZMIAR]) = 0;
    
    char getZnak() { return znak; }
    char getPlec() { return plec; }
    int getX() { return x; }
    int getY() { return y; }
    
    virtual char getWyswietlanyZnak() { return znak; }
    
    bool czyDorosly() { return wiek >= 4; } 
    virtual bool czyUmarw() { return wiek >= maxWiek; }
    
    void postarz() { 
        wiek++; 
        if (czasDoRozmnozenia > 0) czasDoRozmnozenia--;
    }
};

class Lew;
class Antylopa;

// ==================================================
// 2. KLASA TRAWA (Super odporna, szybko rosn¹ca)
// ==================================================

class Trawa : public Organizm {
public:
    Trawa(int x, int y) : Organizm(x, y, 'T', 'X', 50) {} // ¯yje a¿ 50 tur
    
    void akcja(Organizm* plansza[ROZMIAR][ROZMIAR]) {
        postarz();
        if (rand() % 100 < 50) { // 50% szans na rozsianie siê w ka¿dej turze
            int dx = (rand() % 3) - 1;
            int dy = (rand() % 3) - 1;
            int nx = x + dx;
            int ny = y + dy;
            if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
                if (plansza[nx][ny] == NULL) {
                    plansza[nx][ny] = new Trawa(nx, ny);
                }
            }
        }
    }
};

// ==================================================
// 3. KLASA BAZOWA ZWIERZ¥T
// ==================================================

class Zwierze : public Organizm {
protected:
    int glod; 
public:
    Zwierze(int x, int y, char z, char p, int mw) : Organizm(x, y, z, p, mw), glod(0) {}

    virtual char getWyswietlanyZnak() {
        if (!czyDorosly()) {
            if (znak == 'L') return 'l';
            if (znak == 'A') return 'a';
        }
        return znak;
    }

    void ruchLosowy(Organizm* plansza[ROZMIAR][ROZMIAR]) {
        int dx = (rand() % 3) - 1;
        int dy = (rand() % 3) - 1;
        int nx = x + dx;
        int ny = y + dy;
        
        if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
            if (plansza[nx][ny] == NULL) {
                plansza[nx][ny] = plansza[x][y];
                plansza[x][y] = NULL;
                x = nx;
                y = ny;
            }
        }
    }

    bool zrobKrokWStrone(Organizm* plansza[ROZMIAR][ROZMIAR], int cx, int cy) {
        int nx = x; int ny = y;
        if (cx > x) nx++; else if (cx < x) nx--;
        if (cy > y) ny++; else if (cy < y) ny--;
        
        if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
            if (plansza[nx][ny] == NULL) {
                plansza[nx][ny] = plansza[x][y];
                plansza[x][y] = NULL;
                x = nx; y = ny;
                return true;
            }
        }
        return false;
    }

    bool zjedzJesliObok(Organizm* plansza[ROZMIAR][ROZMIAR], char celZnak);
    bool idzWStroneCelu(Organizm* plansza[ROZMIAR][ROZMIAR], char celZnak, int zasieg);
    bool idzDoPartnera(Organizm* plansza[ROZMIAR][ROZMIAR], int zasieg);
    bool sprobujRozmnozyc(Organizm* plansza[ROZMIAR][ROZMIAR]);
};

// ==================================================
// 4. DEFINICJA GATUNKU: LEW
// ==================================================

class Lew : public Zwierze {
public:
    Lew(int x, int y, char p) : Zwierze(x, y, 'L', p, 40) {} 
    
    virtual bool czyUmarw() {
        return (wiek >= maxWiek || glod >= 15); // Wytrzyma a¿ 15 tur bez jedzenia
    }

    void akcja(Organizm* plansza[ROZMIAR][ROZMIAR]) {
        postarz();
        glod++; 

        if (glod > 3) {
            if (zjedzJesliObok(plansza, 'A')) return;
            if (idzWStroneCelu(plansza, 'A', 3)) return; 
        }

        if (czyDorosly() && glod <= 5 && czasDoRozmnozenia == 0) {
            if (sprobujRozmnozyc(plansza)) return;
            if (idzDoPartnera(plansza, 3)) return; 
        }

        if (zjedzJesliObok(plansza, 'A')) return;
        ruchLosowy(plansza);
    }
};

// ==================================================
// 5. DEFINICJA GATUNKU: ANTYLOPA
// ==================================================

class Antylopa : public Zwierze {
public:
    Antylopa(int x, int y, char p) : Zwierze(x, y, 'A', p, 35) {} 
    
    virtual bool czyUmarw() {
        return (wiek >= maxWiek || glod >= 12); // Wytrzyma 12 tur bez jedzenia
    }

    void akcja(Organizm* plansza[ROZMIAR][ROZMIAR]) {
        postarz();
        glod++;

        if (glod > 4) {
            if (zjedzJesliObok(plansza, 'T')) return;
            if (idzWStroneCelu(plansza, 'T', 2)) return;
        }

        if (czyDorosly() && glod < 6 && czasDoRozmnozenia == 0) {
            if (sprobujRozmnozyc(plansza)) return;
            if (idzDoPartnera(plansza, 3)) return;
        }

        if (zjedzJesliObok(plansza, 'T')) return;
        ruchLosowy(plansza);
    }
};

// ==================================================
// 6. IMPLEMENTACJA LOGIKI AI DLA ZWIERZ¥T
// ==================================================

bool Zwierze::zjedzJesliObok(Organizm* plansza[ROZMIAR][ROZMIAR], char celZnak) {
    for (int dx = -1; dx <= 1; dx++) {
        for (int dy = -1; dy <= 1; dy++) {
            int nx = x + dx; int ny = y + dy;
            if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
                if (plansza[nx][ny] != NULL && plansza[nx][ny]->getZnak() == celZnak) {
                    delete plansza[nx][ny]; 
                    plansza[nx][ny] = plansza[x][y];
                    plansza[x][y] = NULL;
                    x = nx; y = ny;
                    glod = 0; 
                    return true;
                }
            }
        }
    }
    return false;
}

bool Zwierze::idzWStroneCelu(Organizm* plansza[ROZMIAR][ROZMIAR], char celZnak, int zasieg) {
    for (int r = 1; r <= zasieg; r++) {
        for (int dx = -r; dx <= r; dx++) {
            for (int dy = -r; dy <= r; dy++) {
                int nx = x + dx; int ny = y + dy;
                if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
                    if (plansza[nx][ny] != NULL && plansza[nx][ny]->getZnak() == celZnak) {
                        return zrobKrokWStrone(plansza, nx, ny);
                    }
                }
            }
        }
    }
    return false;
}

bool Zwierze::idzDoPartnera(Organizm* plansza[ROZMIAR][ROZMIAR], int zasieg) {
    for (int r = 1; r <= zasieg; r++) {
        for (int dx = -r; dx <= r; dx++) {
            for (int dy = -r; dy <= r; dy++) {
                int nx = x + dx; int ny = y + dy;
                if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
                    Organizm* sasiad = plansza[nx][ny];
                    if (sasiad != NULL && sasiad->getZnak() == this->znak && 
                        sasiad->czyDorosly() && sasiad->getPlec() != this->plec) {
                        return zrobKrokWStrone(plansza, nx, ny);
                    }
                }
            }
        }
    }
    return false;
}

bool Zwierze::sprobujRozmnozyc(Organizm* plansza[ROZMIAR][ROZMIAR]) {
    bool partnerObok = false;
    for (int dx = -1; dx <= 1; dx++) {
        for (int dy = -1; dy <= 1; dy++) {
            int nx = x + dx; int ny = y + dy;
            if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
                Organizm* sasiad = plansza[nx][ny];
                if (sasiad != NULL && sasiad->getZnak() == this->znak && 
                    sasiad->czyDorosly() && sasiad->getPlec() != this->plec) {
                    partnerObok = true;
                    break;
                }
            }
        }
        if (partnerObok) break;
    }

    if (partnerObok) {
        for (int dx = -1; dx <= 1; dx++) {
            for (int dy = -1; dy <= 1; dy++) {
                int nx = x + dx; int ny = y + dy;
                if (nx >= 0 && nx < ROZMIAR && ny >= 0 && ny < ROZMIAR) {
                    if (plansza[nx][ny] == NULL) {
                        char nowaPlec = (rand() % 2 == 0) ? 'M' : 'K';
                        if (this->znak == 'L') plansza[nx][ny] = new Lew(nx, ny, nowaPlec);
                        else if (this->znak == 'A') plansza[nx][ny] = new Antylopa(nx, ny, nowaPlec);
                        
                        // Znacznie krótszy urlop macierzyñski po aktualizacji
                        czasDoRozmnozenia = (this->znak == 'L') ? 5 : 3; 
                        return true; 
                    }
                }
            }
        }
    }
    return false;
}

