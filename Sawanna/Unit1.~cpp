void __fastcall TForm1::ButtonTuraClick(TObject *Sender)
{
    bool wykonanyRuch[ROZMIAR][ROZMIAR];
    for(int i = 0; i < ROZMIAR; i++) {
        for(int j = 0; j < ROZMIAR; j++) {
            wykonanyRuch[i][j] = false;
        }
    }

    for(int j = 0; j < ROZMIAR; j++) {
        for(int i = 0; i < ROZMIAR; i++) {
            if(plansza[i][j] != NULL) {
                if (plansza[i][j]->czyUmarw()) {
                    delete plansza[i][j];
                    plansza[i][j] = NULL;
                }
                else if (!wykonanyRuch[i][j]) {
                    Organizm* org = plansza[i][j];
                    org->akcja(plansza);
                    
                    int nx = org->getX();
                    int ny = org->getY();
                    wykonanyRuch[nx][ny] = true;
                }
            }
        }
    }

    AktualizujEkran();
}

void TForm1::AktualizujEkran()
{
    for(int j = 0; j < ROZMIAR; j++) {
        for(int i = 0; i < ROZMIAR; i++) {
            if(plansza[i][j] != NULL) {
                AnsiString info = AnsiString(plansza[i][j]->getWyswietlanyZnak());
                if (plansza[i][j]->getPlec() != 'X') {
                    info += AnsiString(plansza[i][j]->getPlec());
                }
                StringGrid1->Cells[i][j] = info;
            } else {
                StringGrid1->Cells[i][j] = "";
            }
        }
    }
}

void __fastcall TForm1::FormDestroy(TObject *Sender)
{
    for(int i = 0; i < ROZMIAR; i++) {
        for(int j = 0; j < ROZMIAR; j++) {
            if(plansza[i][j] != NULL) {
                delete plansza[i][j];
            }
        }
    }
}

void __fastcall TForm1::Timer1Timer(TObject *Sender)
{
    ButtonTuraClick(this); 
}
